<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #F0F2F5; -fx-padding: 20;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

    <HBox alignment="CENTER" spacing="10.0">
        <TextField promptText="buscar almacen..." prefWidth="400" style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #BDC3C7; -fx-padding: 8;"/>
        <Button text="Q" style="-fx-background-color: #0F3443; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;"/>
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox spacing="20.0" alignment="TOP_CENTER" prefWidth="200.0">
            <Button onAction="#onAbrirAgregarClick" text="AGREGAR" style="-fx-background-color: #17A2B8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-pref-width: 150; -fx-padding: 10;"/>
            <Button onAction="#onAbrirEditarClick" text="EDITAR" style="-fx-background-color: #17A2B8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-pref-width: 150; -fx-padding: 10;"/>
            <VBox prefHeight="30.0"/>
            <HBox alignment="CENTER" spacing="5">
                <TextField promptText="ID" prefWidth="100" style="-fx-background-radius: 15;"/>
                <Button text="Q" style="-fx-background-color: #0F3443; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
            <Button text="ELIMINAR" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-pref-width: 150; -fx-padding: 10;"/>
        </VBox>

        <TableView HBox.hgrow="ALWAYS" style="-fx-border-color: #17A2B8; -fx-border-width: 2;">
            <columns>
                <TableColumn text="ID ALMACEN" prefWidth="150"/>
                <TableColumn text="ZONA" prefWidth="150"/>
                <TableColumn text="PISOS" prefWidth="100"/>
                <TableColumn text="DIRECCION" prefWidth="300"/>
            </columns>
        </TableView>
    </HBox>
</VBox>