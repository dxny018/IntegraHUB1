<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #F0F2F5;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.integrahub.DashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #0F3443; -fx-background-radius: 30; -fx-padding: 15 25 15 25;">
            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </BorderPane.margin>

            <Button onAction="#onModuloClick" style="-fx-background-color: #17A2B8; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-weight: bold; -fx-padding: 8 15 8 15;" text="Almacen" />
            <Button onAction="#onModuloClick" style="-fx-background-color: transparent; -fx-border-color: #17A2B8; -fx-text-fill: #17A2B8; -fx-border-radius: 20; -fx-font-weight: bold; -fx-padding: 8 15 8 15;" text="Movimientos" />
            <Button onAction="#onModuloClick" style="-fx-background-color: transparent; -fx-border-color: #17A2B8; -fx-text-fill: #17A2B8; -fx-border-radius: 20; -fx-font-weight: bold; -fx-padding: 8 15 8 15;" text="Productos" />
            <Button onAction="#onModuloClick" style="-fx-background-color: transparent; -fx-border-color: #17A2B8; -fx-text-fill: #17A2B8; -fx-border-radius: 20; -fx-font-weight: bold; -fx-padding: 8 15 8 15;" text="Empleados" />
            <Button onAction="#onModuloClick" style="-fx-background-color: transparent; -fx-border-color: #17A2B8; -fx-text-fill: #17A2B8; -fx-border-radius: 20; -fx-font-weight: bold; -fx-padding: 8 15 8 15;" text="Cliente" />
            <Button onAction="#onModuloClick" style="-fx-background-color: transparent; -fx-border-color: #17A2B8; -fx-text-fill: #17A2B8; -fx-border-radius: 20; -fx-font-weight: bold; -fx-padding: 8 15 8 15;" text="Proveedor" />

            <Button fx:id="btnSalir" onAction="#onSalirClick" style="-fx-background-color: transparent; -fx-border-color: #E74C3C; -fx-text-fill: #E74C3C; -fx-border-radius: 20; -fx-font-weight: bold; -fx-padding: 8 15 8 15;" text="Salir" />
            <HBox HBox.hgrow="ALWAYS" />
            <Circle fill="WHITE" radius="20.0" stroke="#17a2b8" strokeWidth="2.0" />
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" />
    </center>
</BorderPane>