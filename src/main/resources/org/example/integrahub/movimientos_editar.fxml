<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #F0F2F5;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 0 0 10 0;">
        <TextField promptText="buscar movimiento para editar..." prefWidth="300" style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #BDC3C7; -fx-padding: 8;"/>
        <Button text="Q" style="-fx-background-color: #0F3443; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;"/>
    </HBox>
    <VBox alignment="CENTER" spacing="8.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #17A2B8; -fx-border-width: 2; -fx-border-radius: 15;" maxWidth="500">
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="TIPO DE MOVIMIENTO:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-background-color: #E2E8F0; -fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="DESCRIPCION:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-background-color: #E2E8F0; -fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="FECHA REGISTRO:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-background-color: #E2E8F0; -fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="FECHA ORDEN:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-background-color: #E2E8F0; -fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="FECHA CONCLUIDO:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-background-color: #E2E8F0; -fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="CALIFICACION:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-background-color: #E2E8F0; -fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="ID ALMACEN:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-background-color: #E2E8F0; -fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="ID EMPLEADO:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-background-color: #E2E8F0; -fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="ID CLIENTE:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-background-color: #E2E8F0; -fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="ID PROVEEDOR:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-background-color: #E2E8F0; -fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER" spacing="40" style="-fx-padding: 15 0 0 0;">
            <Button onAction="#onGuardarClick" text="GUARDAR" style="-fx-background-color: #17A2B8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-pref-width: 140;"/>
            <Button onAction="#onRegresarPrincipalClick" text="SALIR" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-pref-width: 140;"/>
        </HBox>
    </VBox>
</VBox>