<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #F0F2F5;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <VBox alignment="CENTER" spacing="12.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-border-color: #17A2B8; -fx-border-width: 2; -fx-border-radius: 15;" maxWidth="500">
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="NOMBRE:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="DIRECCION:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="ESPECIALIDAD:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="TELEFONO 1:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="TELEFONO 2:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="TIPO DE MATERIAL:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER_RIGHT" spacing="15"><Label text="ID ALMACEN:" style="-fx-font-weight: bold;"/><TextField prefWidth="250" style="-fx-border-color: #BDC3C7;"/></HBox>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
            <Button onAction="#onGuardarClick" text="GUARDAR" style="-fx-background-color: #17A2B8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-pref-width: 140;"/>
            <Button onAction="#onLimpiarClick" text="LIMPIAR CAMPOS" style="-fx-background-color: transparent; -fx-border-color: #17A2B8; -fx-text-fill: #17A2B8; -fx-font-weight: bold; -fx-border-radius: 15; -fx-pref-width: 140;"/>
            <Button onAction="#onRegresarPrincipalClick" text="SALIR" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-pref-width: 140;"/>
        </HBox>
    </VBox>
</VBox>